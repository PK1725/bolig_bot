# Filtering criteria
MAX_PRICE="12000"   # Only accept listings priced <= this
MIN_ROOMS="2"       # Only accept listings with >= this many rooms
MIN_SQM="65"        # Only accept listings with >= this many square meters
MIN_PERIOD="12"      # Only accept listings with a minimum rental period in months
